---
import Main from "../../layouts/Main.astro";
import { AppConfig } from "../../config/AppConfig";
import BlogPostDynamic from "../../components/blog/BlogPostDynamic.tsx";

export async function getStaticPaths() {
  const workerUrl = import.meta.env.PUBLIC_MEDIUM_WORKER_URL;
  if (!workerUrl) {
    console.error("PUBLIC_MEDIUM_WORKER_URL is not set — no blog pages generated");
    return [];
  }

  let posts;
  try {
    const res = await fetch(`${workerUrl}/api/blog`);
    if (!res.ok) throw new Error(`Worker returned ${res.status}`);
    posts = await res.json();
  } catch (e) {
    console.error("Failed to fetch blog posts from worker", e);
    return [];
  }

  return posts.map((post: { title: string; pubDate: string; link: string; ogImage: string | null }) => {
    const slug = (post.title || "")
      .toLowerCase()
      .replace(/[^\w\s-]/g, "")
      .replace(/[\s_-]+/g, "-")
      .replace(/^-+|-+$/g, "");

    return {
      params: { slug },
      props: {
        title: post.title || "",
        pubDate: post.pubDate || "",
        link: post.link || "",
        ogImage: post.ogImage || "/assets/og-images/blog.png",
      },
    };
  });
}

const { title, pubDate, link, ogImage } = Astro.props;
const currentSlug = Astro.params.slug;
---

<Main
  meta={{
    title: `${title} | ${AppConfig.title}`,
    description: `Blog post by ${AppConfig.title}`,
    image: ogImage,
  }}
  hideBackground={true}
>
  <BlogPostDynamic client:load slug={currentSlug || ""} />
</Main>