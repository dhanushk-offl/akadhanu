---
import Parser from "rss-parser";
import Main from "../../layouts/Main.astro";
import { AppConfig } from "../../config/AppConfig";
import BlogPostDynamic from "../../components/blog/BlogPostDynamic.tsx";

const parser = new Parser();
let slugs: string[] = [];

try {
  const feed = await parser.parseURL("https://medium.com/feed/@itzmedhanu");
  slugs = feed.items.map((item) => {
    return (item.title || "")
      .toLowerCase()
      .replace(/[^\w\s-]/g, "")
      .replace(/[\s_-]+/g, "-")
      .replace(/^-+|-+$/g, "");
  });
} catch (e) {
  console.error("Failed to fetch Medium feed for static paths", e);
}

export async function getStaticPaths() {
  const parser = new Parser();
  let feed;
  try {
    feed = await parser.parseURL("https://medium.com/feed/@itzmedhanu");
  } catch (e) {
    return [];
  }

  return feed.items.map((item) => {
    const slug = (item.title || "")
      .toLowerCase()
      .replace(/[^\w\s-]/g, "")
      .replace(/[\s_-]+/g, "-")
      .replace(/^-+|-+$/g, "");

    return {
      params: { slug },
      props: {
        title: item.title || "",
        pubDate: item.pubDate || "",
        link: item.link || "",
        ogImage:
          (item["content:encoded"] || item.content || "").match(
            /<img[^>]+src="([^">]+)"/
          )?.[1] || "/assets/og-images/blog.png",
      },
    };
  });
}

const { title, pubDate, link, ogImage } = Astro.props;
const currentSlug = Astro.params.slug;
---

<Main
  meta={{
    title: `${title} | ${AppConfig.title}`,
    description: `Blog post by ${AppConfig.title}`,
    image: ogImage,
  }}
  hideBackground={true}
>
  <BlogPostDynamic client:load slug={currentSlug || ""} />
</Main>