---
import Main from "../../layouts/Main.astro";
import { AppConfig } from "../../config/AppConfig";
import PageHeader from "../../components/PageHeader.astro";
import BlogListingDynamic from "../../components/blog/BlogListingDynamic.tsx";
---

<Main
  meta={{
    title: `Blog | ${AppConfig.title}`,
    description: AppConfig.description,
    image: "/assets/og-images/blog.png",
  }}
>
  <div class="pb-8 pt-2">
    <PageHeader
      title="Writing"
      emoji="📝"
      description="System logs on life, SaaS, and engineering."
    />

    <BlogListingDynamic client:load />
  </div>
</Main>